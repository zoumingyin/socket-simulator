# ===================== 后端 API 服务配置 =====================
# 管理 API 端口（默认 3080）
API_PORT=3080

# 允许的 CORS 来源（生产环境应限制为具体域名）
ALLOWED_ORIGIN=http://localhost:5173

# ===================== 前端配置（VITE_ 前缀） =====================
# 后端 API 地址（开发环境）
VITE_API_BASE=http://localhost:3080

# 管理 Socket.IO 路径
VITE_ADMIN_SOCKET_PATH=/admin/socket.io
