{
  "$schema": "https://schema.tauri.app/v2/config.json",
  "productName": "Socket 服务管理平台",
  "version": "1.0.0",
  "identifier": "com.socket-service-manager",
  "build": {
    "beforeDevCommand": {
      "script": "node node_modules/vite/bin/vite.js",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build",
      "cwd": ".."
    },
    "devUrl": "http://localhost:4173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Socket 服务管理平台",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "devtools": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
